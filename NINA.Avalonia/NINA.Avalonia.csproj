<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- NINADbContext.Migrate() (NINA.Core, portable) reads these relative to
         AppDomain.CurrentDomain.BaseDirectory, so every executable that touches the DSO
         catalog DB needs its own copy - same as NINA.csproj's own Content items for this,
         globbed instead of hand-listed so new migrations upstream don't need a matching edit here. -->
    <Content Include="..\NINA\Database\**\*.sql" Link="Database\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- NOVAS.cs's managed (non-Windows) path reads the real CIO locator lookup table via
         ManagedNovas.SetRacioFile/CioArray - same "every executable needs its own copy of a
         real data file" situation as the Database SQL scripts above. -->
    <Content Include="..\NOVAS31\NOVAS31\CIO_RA.TXT" Link="NOVAS\CIO_RA.TXT">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="OxyPlot.Avalonia" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NINA.Core/NINA.Core.csproj" />
    <ProjectReference Include="../NINA.Profile/NINA.Profile.csproj" />
    <ProjectReference Include="../NINA.Astrometry/NINA.Astrometry.csproj" />
    <ProjectReference Include="../NINA.Image/NINA.Image.csproj" />
    <ProjectReference Include="../NINA.Equipment/NINA.Equipment.csproj" />
    <ProjectReference Include="../NINA.Platesolving/NINA.Platesolving.csproj" />
    <ProjectReference Include="../NINA.WPF.Base/NINA.WPF.Base.csproj" />
    <ProjectReference Include="../NINA.Sequencer/NINA.Sequencer.csproj" />
    <ProjectReference Include="../NINA.Plugin/NINA.Plugin.csproj" />
  </ItemGroup>
</Project>
