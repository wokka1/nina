<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NINA.Avalonia.ViewModels"
        xmlns:seq="using:NINA.Sequencer"
        xmlns:seqc="using:NINA.Sequencer.Container"
        xmlns:oxy="using:OxyPlot.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="NINA.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NINA.Avalonia">

    <!-- No Design.DataContext here: MainViewModel now requires a real IProfileService via its
         constructor (see CompositionRoot.Compose), so it can no longer be parameterlessly
         instantiated for the XAML previewer. Runtime DataContext is set in App.axaml.cs. -->

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding StatusMessage}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding CurrentTime}" FontSize="14" Opacity="0.7" />
            <TextBlock Text="{Binding NinaCoreIntegrationTest}" FontSize="13" Opacity="0.9" Foreground="LightGreen" />
            <TextBlock Text="{Binding ActiveProfileName, StringFormat='Active profile: {0}'}" FontSize="13" Opacity="0.9" Foreground="LightBlue" />
        </StackPanel>

        <!-- Real navigation shell (Phase 0): one TabItem per NINA.Core.Enum.ApplicationTab entry,
             same order as the real app. Equipment now has real Camera + Telescope panels
             (Phase 1) - the rest get built out phase by phase per the roadmap in
             wokka1/nina#1, one device-card WrapPanel entry at a time. -->
        <TabControl SelectedIndex="{Binding TabIndex}">
            <TabItem Header="Equipment">
                <!-- Real NINA.WPF.Base ViewModels underneath each card (CameraVM/TelescopeVM
                     etc. via CompositionRoot.Compose), not rewrites. Every device VM's
                     interface (ICameraVM/ITelescopeVM/IDeviceChooserVM - deliberately kept for
                     testability same as the real app) omits the concrete class's
                     Connect/Disconnect/Rescan commands and *Info status property, so Avalonia's
                     default compiled bindings (which type-check strictly against the declared
                     interface type) can't see them - {ReflectionBinding} (runtime/reflection)
                     is used for just those paths per card instead of weakening
                     EquipmentViewModel's properties to their concrete classes. (ICameraVM
                     happens to also declare DeviceChooserVM itself, unlike ITelescopeVM - an
                     inconsistency in the real interfaces, not something introduced here - so
                     Camera's chooser binding is plain {Binding} while Telescope's needs
                     {ReflectionBinding} too; check each device type's own interface rather than
                     assuming the same binding style carries over.) No Setup Dialog buttons yet
                     for the same reason (SetupDialogCommand lives on the concrete
                     DeviceChooserVM&lt;T&gt; base) - small, deliberately deferred, not needed to
                     prove connect/disconnect/status. -->
                <WrapPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Camera" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding EquipmentVM.CameraVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{Binding EquipmentVM.CameraVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.CameraVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.CameraVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.CameraVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.CameraVM.CameraInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.CameraVM.CameraInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Temperature" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.CameraVM.CameraInfo.Temperature, StringFormat='{}{0:0.0} °C'}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cooler" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.CameraVM.CameraInfo.CoolerOn, StringFormat='On: {0}'}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Telescope" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.TelescopeVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.TelescopeVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- {ReflectionBinding}, not {Binding}: the ItemsSource
                                             above is itself a ReflectionBinding (untyped at
                                             compile time), so the compiler has no static item
                                             type to check a compiled binding against here -
                                             unlike Camera's version of this same template, where
                                             ItemsSource is a plain typed {Binding} and the
                                             compiler can infer IDevice for this nested one. -->
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.TelescopeVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.TelescopeVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.TelescopeVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="RA / Dec" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.RightAscension, StringFormat='{}{0:0.0000}h'}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tracking" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.TrackingEnabled}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="At Park" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.AtPark}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Filter Wheel" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.FilterWheelVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.FilterWheelVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.FilterWheelVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.FilterWheelVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.FilterWheelVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FilterWheelVM.FilterWheelInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FilterWheelVM.FilterWheelInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Selected Filter" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FilterWheelVM.FilterWheelInfo.SelectedFilter.Name}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Moving" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FilterWheelVM.FilterWheelInfo.IsMoving}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Focuser" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.FocuserVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.FocuserVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.FocuserVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.FocuserVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.FocuserVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Position" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.Position}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Temperature" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.Temperature, StringFormat='{}{0:0.0} °C'}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Moving" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.IsMoving}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Rotator" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.RotatorVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.RotatorVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.RotatorVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.RotatorVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.RotatorVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.RotatorVM.RotatorInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.RotatorVM.RotatorInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Position" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.RotatorVM.RotatorInfo.Position}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Moving" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.RotatorVM.RotatorInfo.IsMoving}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Dome" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.DomeVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.DomeVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.DomeVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.DomeVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.DomeVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Shutter" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.ShutterStatus}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="At Park" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.AtPark}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Slewing" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.Slewing}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Guider" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.GuiderVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.GuiderVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.GuiderVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.GuiderVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.GuiderVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.GuiderVM.GuiderInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.GuiderVM.GuiderInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Pixel Scale" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.GuiderVM.GuiderInfo.PixelScale, StringFormat='{}{0:0.00} arcsec/px'}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Switch's real status surface is a whole writable/readonly switch-value
                         grid (SwitchInfo doesn't reduce to a few scalar fields the way the other
                         device types do) - out of scope for this minimal connect/status card,
                         same spirit as skipping Setup Dialog buttons elsewhere. Just proves the
                         chooser/connect/disconnect pattern here; a real switch grid is deferred. -->
                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Switch" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.SwitchVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.SwitchVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.SwitchVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.SwitchVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.SwitchVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SwitchVM.SwitchInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SwitchVM.SwitchInfo.Name}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Flat Device" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.FlatDeviceVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.FlatDeviceVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.FlatDeviceVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.FlatDeviceVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.FlatDeviceVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cover" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.CoverState}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Light" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.LightOn, StringFormat='On: {0}'}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Weather Data" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.WeatherDataVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.WeatherDataVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.WeatherDataVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.WeatherDataVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.WeatherDataVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.WeatherDataVM.WeatherDataInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.WeatherDataVM.WeatherDataInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cloud Cover" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.WeatherDataVM.WeatherDataInfo.CloudCover, StringFormat='{}{0:0.0}%'}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Humidity" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.WeatherDataVM.WeatherDataInfo.Humidity, StringFormat='{}{0:0.0}%'}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Last of the 11 device types - Phase 1 complete once this builds. -->
                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Safety Monitor" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.SafetyMonitorVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.SafetyMonitorVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.SafetyMonitorVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.SafetyMonitorVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.SafetyMonitorVM.DisconnectCommand}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SafetyMonitorVM.SafetyMonitorInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SafetyMonitorVM.SafetyMonitorInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Is Safe" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SafetyMonitorVM.SafetyMonitorInfo.IsSafe}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </WrapPanel>
            </TabItem>
            <TabItem Header="Sky Atlas">
                <TextBlock Margin="0,12,0,0" Opacity="0.6" Text="Sky Atlas / Framing Assistant - Phase 4" />
            </TabItem>
            <TabItem Header="Framing Assistant">
                <TextBlock Margin="0,12,0,0" Opacity="0.6" Text="Framing Assistant - Phase 4" />
            </TabItem>
            <TabItem Header="Flat Wizard">
                <TextBlock Margin="0,12,0,0" Opacity="0.6" Text="Flat Wizard - not yet scoped" />
            </TabItem>
            <TabItem Header="Sequencer">
                <!-- Phase 3: a real NINA.Sequencer.Container.SequenceRootContainer
                     (multi-targeted, portable, unchanged from the WPF app's own domain model),
                     hand-populated with a couple of real Annotation items in a nested
                     SequentialContainer as the starting tree content.
                     Move Up/Down/Remove are bound straight to IDroppable's own real
                     MoveUpCommand/MoveDownCommand/DetachCommand - not new logic, the real app's
                     existing reorder/remove behavior. The Add dropdown is real too now: it lists
                     every SequenceItemCatalog.Entries entry, a real reflection-based discovery
                     of the app's actual [Export(typeof(ISequenceItem))]-tagged types whose
                     constructor dependencies this app's DI container can already satisfy - see
                     SequenceItemCatalog's own doc comment for the full design (not a MEF
                     CompositionContainer, a lighter real bridge to this app's own DI container).
                     Still deferred: per-item-type property editors (dozens of types, each with
                     its own settings) and real drag-and-drop gestures.
                     Two DataTemplates, ISequenceContainer listed first: Avalonia picks the first
                     matching template in TreeView.DataTemplates, and containers are-a
                     ISequenceItem too, so order here is what makes containers get their
                     children shown instead of falling through to the leaf-item template. -->
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding SequencerVM.Catalog.Entries}"
                                  SelectedItem="{Binding SequencerVM.SelectedCatalogEntry}"
                                  Width="260">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Category}" Opacity="0.6" />
                                        <TextBlock Text="-" Opacity="0.6" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Add" Command="{Binding SequencerVM.AddFromCatalogCommand}" />
                        <Button Content="Move Up" Command="{Binding SequencerVM.SelectedItem.MoveUpCommand}" />
                        <Button Content="Move Down" Command="{Binding SequencerVM.SelectedItem.MoveDownCommand}" />
                        <Button Content="Remove" Command="{Binding SequencerVM.SelectedItem.DetachCommand}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,260">
                        <TreeView Grid.Column="0" ItemsSource="{Binding SequencerVM.RootContainer.Items}" SelectedItem="{Binding SequencerVM.SelectedItem}">
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="seqc:ISequenceContainer" ItemsSource="{Binding Items}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </TreeDataTemplate>
                                <DataTemplate DataType="seq:ISequenceEntity">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                        <!-- Generic reflection-based property panel (PropertyEditRow) for
                             whatever's selected - see SequencerViewModel's doc comment for why
                             this is one uniform editor instead of 52+ hand-built per-item-type
                             views. Only simple value-typed, leaf-declared properties show up
                             here; anything else is deliberately absent rather than shown broken. -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
                            <TextBlock Text="Properties" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding SequencerVM.SelectedItemProperties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,*" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Imaging">
                <!-- Phase 2's first real slice: a real capture through the actual portable
                     pipeline (CameraVM.Capture/Download -> ToImageData -> RenderImage ->
                     Stretch -> RawPixels -> a real Avalonia bitmap), not a placeholder. Connect
                     a camera on the Equipment tab first (the Simulator camera works with no
                     real hardware) - Connected is bound compiled since ICameraVM declares it
                     directly (IDeviceVM&lt;T&gt; base member), unlike the ReflectionBinding
                     paths used for the concrete-only members on the Equipment tab's cards. -->
                <StackPanel Margin="0,12,0,0" Spacing="8" MaxWidth="700">
                    <!-- Exposure/binning/gain sourced from the connected camera's own
                         CameraInfo.BinningModes/Gains (ImagingViewModel.RefreshCameraSettings,
                         run on the Connected event) - not hardcoded, reflects whatever the real
                         device actually reports. -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="Exposure (s)" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding ImagingVM.ExposureTime}" Minimum="0.001" Increment="0.5" Width="110" FormatString="0.###" />
                        <TextBlock Grid.Column="2" Text="Binning" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding ImagingVM.AvailableBinningModes}" SelectedItem="{Binding ImagingVM.SelectedBinning}" Width="90">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="4" Text="Gain" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <NumericUpDown Grid.Column="5" Value="{Binding ImagingVM.Gain}" Minimum="{Binding ImagingVM.GainMin}" Maximum="{Binding ImagingVM.GainMax}" Width="100" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="Capture" Command="{Binding ImagingVM.CaptureCommand}" IsEnabled="{Binding !ImagingVM.IsCapturing}" />
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding ImagingVM.CancelCaptureCommand}" IsEnabled="{Binding ImagingVM.IsCapturing}" />
                        <TextBlock Grid.Column="2" Text="{Binding ImagingVM.CaptureStatus}" VerticalAlignment="Center" />
                    </Grid>
                    <Border BorderBrush="Gray" BorderThickness="1" MinHeight="300">
                        <Image Source="{Binding ImagingVM.Image}" Stretch="Uniform" />
                    </Border>
                    <!-- Real StarDetection.DetectPortable() output (via IRenderedImage.
                         DetectStars(), see ImagingViewModel's doc comment) - text stats, not a
                         visual marker overlay yet (deliberately deferred, needs real
                         pixel-to-display-coordinate math against the image's Stretch="Uniform"
                         scaling). -->
                    <TextBlock Text="{Binding ImagingVM.StarDetectionStatus}" Opacity="0.8" />
                    <!-- Real IImageData.Statistics (mean/median/stdev/min/max), same source
                         NINA/ViewModel/ImageStatisticsVM.cs uses. -->
                    <TextBlock Text="{Binding ImagingVM.StatisticsStatus}" Opacity="0.8" />
                    <!-- Real OxyPlot.Avalonia PlotView bound to the real IImageStatistics.Histogram
                         data - OxyPlot's model/series types are UI-framework-agnostic, only the
                         rendering package differs from the WPF app's OxyPlot.Wpf. -->
                    <oxy:PlotView Model="{Binding ImagingVM.HistogramModel}" Height="180" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Options">
                <TextBlock Margin="0,12,0,0" Opacity="0.6" Text="Options / Profile management - Phase 5" />
            </TabItem>
            <TabItem Header="Plugins">
                <TextBlock Margin="0,12,0,0" Opacity="0.6" Text="Plugins - Phase 5" />
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>
