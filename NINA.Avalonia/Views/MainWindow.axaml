<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NINA.Avalonia.ViewModels"
        xmlns:seq="using:NINA.Sequencer"
        xmlns:seqc="using:NINA.Sequencer.Container"
        xmlns:oxy="using:OxyPlot.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="NINA.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="RootWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="NINA.Avalonia">

    <!-- No Design.DataContext here: MainViewModel now requires a real IProfileService via its
         constructor (see CompositionRoot.Compose), so it can no longer be parameterlessly
         instantiated for the XAML previewer. Runtime DataContext is set in App.axaml.cs. -->

    <Window.Styles>
        <!-- Real NINA theme support (2026-08-22) - only matches while the root Window carries
             the "nina-themed" class (MainWindow.axaml.cs toggles it from OptionsViewModel's
             UsePlainDefault/SelectedTheme); with the class absent (today's default), none of
             this matches and the window is pixel-identical to plain stock Fluent. Brush values
             come from NinaThemeService, driven by the real, portable NINA.Profile ColorSchema
             data (16 built-in themes + 2 custom - see Options tab). Covers the highest-visible-
             area controls (Window/TextBlock/Button/TabItem/ComboBox/TextBox/NumericUpDown/
             CheckBox) via their own base Background/Foreground/BorderBrush properties -
             deliberately not chasing per-visual-state (:pointerover/:selected template-part)
             styling the way the real WPF app's ~40 Style files do; functional first slice, same
             proportion-of-effort call as everywhere else in this project. -->
        <Style Selector="Window.nina-themed">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        </Style>
        <Style Selector="Window.nina-themed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="Window.nina-themed Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Window.nina-themed TabItem">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="Window.nina-themed ComboBox">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Window.nina-themed TextBox">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Window.nina-themed NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Window.nina-themed CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
    </Window.Styles>

    <Panel>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding StatusMessage}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding CurrentTime}" FontSize="14" Opacity="0.7" />
            <TextBlock Text="{Binding NinaCoreIntegrationTest}" FontSize="13" Opacity="0.9" Foreground="LightGreen" />
            <TextBlock Text="{Binding ActiveProfileName, StringFormat='Active profile: {0}'}" FontSize="13" Opacity="0.9" Foreground="LightBlue" />
        </StackPanel>

        <!-- Real navigation shell (Phase 0): one TabItem per NINA.Core.Enum.ApplicationTab entry,
             same order as the real app. Equipment now has real Camera + Telescope panels
             (Phase 1) - the rest get built out phase by phase per the roadmap in
             wokka1/nina#1, one device-card WrapPanel entry at a time. -->
        <TabControl SelectedIndex="{Binding TabIndex}">
            <TabItem Header="Equipment">
                <!-- Real NINA.WPF.Base ViewModels underneath each card (CameraVM/TelescopeVM
                     etc. via CompositionRoot.Compose), not rewrites. Every device VM's
                     interface (ICameraVM/ITelescopeVM/IDeviceChooserVM - deliberately kept for
                     testability same as the real app) omits the concrete class's
                     Connect/Disconnect/Rescan commands and *Info status property, so Avalonia's
                     default compiled bindings (which type-check strictly against the declared
                     interface type) can't see them - {ReflectionBinding} (runtime/reflection)
                     is used for just those paths per card instead of weakening
                     EquipmentViewModel's properties to their concrete classes. (ICameraVM
                     happens to also declare DeviceChooserVM itself, unlike ITelescopeVM - an
                     inconsistency in the real interfaces, not something introduced here - so
                     Camera's chooser binding is plain {Binding} while Telescope's needs
                     {ReflectionBinding} too; check each device type's own interface rather than
                     assuming the same binding style carries over.) Setup Dialog buttons are real
                     now too - SetupDialogCommand lives on the concrete DeviceChooserVM&lt;T&gt;
                     base, not any interface, so it always needs {ReflectionBinding} regardless of
                     whether that device's chooser binding otherwise could be plain {Binding};
                     IsVisible checks IDevice.HasSetupDialog (a real interface member) so the
                     button only shows for devices that actually have one. -->
                <WrapPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Camera" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding EquipmentVM.CameraVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{Binding EquipmentVM.CameraVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.CameraVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.CameraVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.CameraVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.CameraVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.CameraVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.CameraVM.CameraInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.CameraVM.CameraInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Temperature" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.CameraVM.CameraInfo.Temperature, StringFormat='{}{0:0.0} °C'}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cooler" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.CameraVM.CameraInfo.CoolerOn, StringFormat='On: {0}'}" />
                            </Grid>
                        </Border>

                        <!-- Real ICameraVM.SetCooler/SetTemperature, via new EquipmentViewModel
                             wrapper commands (see their own doc comment). -->
                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Cooler On" Command="{ReflectionBinding EquipmentVM.SetCoolerOnCommand}" />
                                <Button Content="Cooler Off" Command="{ReflectionBinding EquipmentVM.SetCoolerOffCommand}" />
                                <NumericUpDown Value="{ReflectionBinding EquipmentVM.TargetCoolingTemp}" FormatString="0.0" Width="110" />
                                <Button Content="Set Temp" Command="{ReflectionBinding EquipmentVM.SetCameraTemperatureCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Telescope" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.TelescopeVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.TelescopeVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- {ReflectionBinding}, not {Binding}: the ItemsSource
                                             above is itself a ReflectionBinding (untyped at
                                             compile time), so the compiler has no static item
                                             type to check a compiled binding against here -
                                             unlike Camera's version of this same template, where
                                             ItemsSource is a plain typed {Binding} and the
                                             compiler can infer IDevice for this nested one. -->
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.TelescopeVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.TelescopeVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.TelescopeVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.TelescopeVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.TelescopeVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="RA / Dec" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.RightAscension, StringFormat='{}{0:0.0000}h'}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tracking" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.TrackingEnabled}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="At Park" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.TelescopeVM.TelescopeInfo.AtPark}" />
                            </Grid>
                        </Border>

                        <!-- Real ITelescopeVM.ParkTelescope/UnparkTelescope/StopSlew/
                             SetTrackingEnabled, via new EquipmentViewModel wrapper commands
                             (see their own doc comment) - deliberately scoped to these
                             well-understood operations, not a full manual slew-to-coordinates
                             UI (see the doc comment for why). -->
                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Park" Command="{ReflectionBinding EquipmentVM.ParkTelescopeCommand}" />
                                <Button Content="Unpark" Command="{ReflectionBinding EquipmentVM.UnparkTelescopeCommand}" />
                                <Button Content="Stop Slew" Command="{ReflectionBinding EquipmentVM.StopTelescopeSlewCommand}" />
                                <Button Content="Toggle Tracking" Command="{ReflectionBinding EquipmentVM.ToggleTelescopeTrackingCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Filter Wheel" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.FilterWheelVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.FilterWheelVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.FilterWheelVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.FilterWheelVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.FilterWheelVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.FilterWheelVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.FilterWheelVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FilterWheelVM.FilterWheelInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FilterWheelVM.FilterWheelInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Selected Filter" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FilterWheelVM.FilterWheelInfo.SelectedFilter.Name}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Moving" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FilterWheelVM.FilterWheelInfo.IsMoving}" />
                            </Grid>
                        </Border>

                        <!-- Real FilterWheelVM.ChangeFilterCommand/TargetFilter (2026-08-22) -
                             concrete-class-only members, same ReflectionBinding-only situation as
                             SetupDialogCommand. AvailableFilters is new on EquipmentViewModel -
                             GetAllFilters() is device-reported and only real once connected. -->
                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox Width="220"
                                          ItemsSource="{ReflectionBinding EquipmentVM.AvailableFilters}"
                                          SelectedItem="{ReflectionBinding EquipmentVM.FilterWheelVM.TargetFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Change Filter" Command="{ReflectionBinding EquipmentVM.FilterWheelVM.ChangeFilterCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Focuser" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.FocuserVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.FocuserVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.FocuserVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.FocuserVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.FocuserVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.FocuserVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.FocuserVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Position" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.Position}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Temperature" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.Temperature, StringFormat='{}{0:0.0} °C'}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Moving" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.IsMoving}" />
                            </Grid>
                        </Border>

                        <!-- Real IFocuserVM.MoveFocuser/ToggleTempComp (2026-08-22), via new
                             EquipmentViewModel wrapper commands - same "existing method, no
                             command wired to it" gap as Camera/Telescope. TempComp checkbox is
                             display-only (device-reported, updated by the polling loop); the
                             button is the real user action, matching how Cooler On/Off buttons
                             sit next to Camera's own read-only Cooler status line above. -->
                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <NumericUpDown Value="{ReflectionBinding EquipmentVM.TargetFocuserPosition}" FormatString="0" Width="110" />
                                    <Button Content="Move To" Command="{ReflectionBinding EquipmentVM.MoveFocuserCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <CheckBox Content="Temp Comp" IsChecked="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.TempComp, Mode=OneWay}" IsHitTestVisible="False" />
                                    <Button Content="Toggle Temp Comp" Command="{ReflectionBinding EquipmentVM.ToggleFocuserTempCompCommand}"
                                            IsVisible="{ReflectionBinding EquipmentVM.FocuserVM.FocuserInfo.TempCompAvailable}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Rotator" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.RotatorVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.RotatorVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.RotatorVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.RotatorVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.RotatorVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.RotatorVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.RotatorVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.RotatorVM.RotatorInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.RotatorVM.RotatorInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Position" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.RotatorVM.RotatorInfo.Position}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Moving" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.RotatorVM.RotatorInfo.IsMoving}" />
                            </Grid>
                        </Border>

                        <!-- Real IRotatorVM.Move/Sync (2026-08-22), via new EquipmentViewModel
                             wrapper commands. Move is the sky-position rotate (matches Position
                             above); Sync recalibrates the rotator's own notion of sky angle
                             without physically moving it - two distinct, both well-understood,
                             commonly-used operations, same scoping call as Telescope's
                             Park/Unpark/Stop set. -->
                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <NumericUpDown Value="{ReflectionBinding EquipmentVM.TargetRotatorPosition}" FormatString="0.0" Width="110" />
                                    <Button Content="Move To" Command="{ReflectionBinding EquipmentVM.MoveRotatorCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <NumericUpDown Value="{ReflectionBinding EquipmentVM.TargetRotatorSyncAngle}" FormatString="0.0" Width="110" />
                                    <Button Content="Sync" Command="{ReflectionBinding EquipmentVM.SyncRotatorCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Dome" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.DomeVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.DomeVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.DomeVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.DomeVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.DomeVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.DomeVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.DomeVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Shutter" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.ShutterStatus}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="At Park" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.AtPark}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Slewing" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.DomeVM.DomeInfo.Slewing}" />
                            </Grid>
                        </Border>

                        <!-- Real IDomeVM.OpenShutter/CloseShutter/Park/FindHome/Enable-
                             DisableFollowing/SlewToAzimuth (2026-08-22), via new
                             EquipmentViewModel wrapper commands - same "existing method, no
                             command wired to it" gap as elsewhere. ToggleDomeFollow picks
                             Enable/Disable based on the real, read-only IDomeVM.FollowEnabled
                             rather than exposing both as separate always-visible buttons. Slew-
                             to-coordinates (as opposed to a raw azimuth) is out of scope, same
                             reasoning as Telescope's manual slew being deferred. -->
                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Open Shutter" Command="{ReflectionBinding EquipmentVM.OpenDomeShutterCommand}" />
                                    <Button Content="Close Shutter" Command="{ReflectionBinding EquipmentVM.CloseDomeShutterCommand}" />
                                    <Button Content="Park" Command="{ReflectionBinding EquipmentVM.ParkDomeCommand}" />
                                    <Button Content="Home" Command="{ReflectionBinding EquipmentVM.HomeDomeCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{ReflectionBinding EquipmentVM.DomeVM.FollowEnabled, StringFormat='Follow: {0}'}" Command="{ReflectionBinding EquipmentVM.ToggleDomeFollowCommand}" />
                                    <NumericUpDown Value="{ReflectionBinding EquipmentVM.TargetDomeAzimuth}" FormatString="0.0" Width="110" />
                                    <Button Content="Slew" Command="{ReflectionBinding EquipmentVM.SlewDomeToAzimuthCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Guider" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.GuiderVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.GuiderVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.GuiderVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.GuiderVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.GuiderVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.GuiderVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.GuiderVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.GuiderVM.GuiderInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.GuiderVM.GuiderInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Pixel Scale" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.GuiderVM.GuiderInfo.PixelScale, StringFormat='{}{0:0.00} arcsec/px'}" />
                            </Grid>
                        </Border>

                        <!-- Real IGuiderVM.StartGuiding/StopGuiding (2026-08-22), via new
                             EquipmentViewModel wrapper commands. forceCalibration is hardcoded
                             false - a real calibrate-from-scratch toggle needs its own explicit
                             UI affordance so it isn't tripped accidentally, out of scope for this
                             pass; Dither/AutoSelectGuideStar/shift-rate similarly deferred as
                             less commonly needed than the core start/stop pair. -->
                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Start Guiding" Command="{ReflectionBinding EquipmentVM.StartGuidingCommand}" />
                                <Button Content="Stop Guiding" Command="{ReflectionBinding EquipmentVM.StopGuidingCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Real writable/readonly switch-value grid (2026-08-02) - SwitchInfo.
                         WritableSwitches/ReadonlySwitches, the real per-switch data the other
                         device types don't have (they reduce to a few scalar status fields).
                         "Set" calls the real, unchanged ISwitchVM.SetSwitchValue via
                         EquipmentViewModel.SetSwitchValueCommand (new - see its own doc
                         comment); readonly switches are display-only, matching what the
                         hardware itself allows. -->
                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Switch" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.SwitchVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.SwitchVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.SwitchVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.SwitchVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.SwitchVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.SwitchVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.SwitchVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SwitchVM.SwitchInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SwitchVM.SwitchInfo.Name}" />
                            </Grid>
                        </Border>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Writable switches" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{ReflectionBinding EquipmentVM.SwitchVM.SwitchInfo.WritableSwitches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="140,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{ReflectionBinding Name}" VerticalAlignment="Center" ToolTip.Tip="{ReflectionBinding Description}" />
                                                <NumericUpDown Grid.Column="1" Value="{ReflectionBinding TargetValue}" Minimum="{ReflectionBinding Minimum}" Maximum="{ReflectionBinding Maximum}" Increment="{ReflectionBinding StepSize}" Width="110" />
                                                <Button Grid.Column="2" Content="Set"
                                                        Command="{ReflectionBinding #RootWindow.DataContext.EquipmentVM.SetSwitchValueCommand}"
                                                        CommandParameter="{ReflectionBinding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Readonly switches" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{ReflectionBinding EquipmentVM.SwitchVM.SwitchInfo.ReadonlySwitches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="140,*" ColumnSpacing="6" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{ReflectionBinding Name}" ToolTip.Tip="{ReflectionBinding Description}" />
                                                <TextBlock Grid.Column="1" Text="{ReflectionBinding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Flat Device" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.FlatDeviceVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.FlatDeviceVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.FlatDeviceVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.FlatDeviceVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.FlatDeviceVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.FlatDeviceVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.FlatDeviceVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cover" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.CoverState}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Light" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.LightOn, StringFormat='On: {0}'}" />
                            </Grid>
                        </Border>

                        <!-- Real IFlatDeviceVM.OpenCover/CloseCover/ToggleLight/SetBrightness
                             (2026-08-22), via new EquipmentViewModel wrapper commands. Cover
                             buttons gated on SupportsOpenClose, brightness row on SupportsOnOff -
                             both real IFlatDeviceInfo capability flags, same IsVisible-gating
                             idea as Setup's HasSetupDialog check above (not every flat panel has
                             a motorized cover or dimmable light). -->
                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.SupportsOpenClose}">
                                    <Button Content="Open Cover" Command="{ReflectionBinding EquipmentVM.OpenFlatCoverCommand}" />
                                    <Button Content="Close Cover" Command="{ReflectionBinding EquipmentVM.CloseFlatCoverCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.SupportsOnOff}">
                                    <Button Content="Toggle Light" Command="{ReflectionBinding EquipmentVM.ToggleFlatLightCommand}" />
                                    <NumericUpDown Value="{ReflectionBinding EquipmentVM.TargetFlatBrightness}"
                                                   Minimum="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.MinBrightness}"
                                                   Maximum="{ReflectionBinding EquipmentVM.FlatDeviceVM.FlatDeviceInfo.MaxBrightness}"
                                                   FormatString="0" Width="90" />
                                    <Button Content="Set Brightness" Command="{ReflectionBinding EquipmentVM.SetFlatBrightnessCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Weather Data" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.WeatherDataVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.WeatherDataVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.WeatherDataVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.WeatherDataVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.WeatherDataVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.WeatherDataVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.WeatherDataVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.WeatherDataVM.WeatherDataInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.WeatherDataVM.WeatherDataInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cloud Cover" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.WeatherDataVM.WeatherDataInfo.CloudCover, StringFormat='{}{0:0.0}%'}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Humidity" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.WeatherDataVM.WeatherDataInfo.Humidity, StringFormat='{}{0:0.0}%'}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Last of the 11 device types - Phase 1 complete once this builds. -->
                    <StackPanel Spacing="8" Width="480" Margin="0,0,24,24">
                        <TextBlock Text="Safety Monitor" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{ReflectionBinding EquipmentVM.SafetyMonitorVM.DeviceChooserVM.Devices}"
                                      SelectedItem="{ReflectionBinding EquipmentVM.SafetyMonitorVM.DeviceChooserVM.SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Rescan" Command="{ReflectionBinding EquipmentVM.SafetyMonitorVM.RescanDevicesCommand}" />
                            <Button Grid.Column="2" Content="Connect" Command="{ReflectionBinding EquipmentVM.SafetyMonitorVM.ConnectCommand}" />
                            <Button Grid.Column="3" Content="Disconnect" Command="{ReflectionBinding EquipmentVM.SafetyMonitorVM.DisconnectCommand}" />
                            <Button Grid.Column="4" Content="Setup" Command="{ReflectionBinding EquipmentVM.SafetyMonitorVM.DeviceChooserVM.SetupDialogCommand}" IsVisible="{ReflectionBinding EquipmentVM.SafetyMonitorVM.DeviceChooserVM.SelectedDevice.HasSetupDialog}" />
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SafetyMonitorVM.SafetyMonitorInfo.Connected}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SafetyMonitorVM.SafetyMonitorInfo.Name}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Is Safe" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{ReflectionBinding EquipmentVM.SafetyMonitorVM.SafetyMonitorInfo.IsSafe}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </WrapPanel>
            </TabItem>
            <TabItem Header="Sky Atlas">
                <!-- Phase 4 first slice: real DSO catalog search via the unchanged, portable
                     NINA.Astrometry.DatabaseInteraction (same SQLite catalog the WPF app reads).
                     No framing/rendering yet - that needs Avalonia-native sky survey image
                     rendering, a separate problem (see SkyAtlasViewModel doc comment). -->
                <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*">
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Object name" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SkyAtlasVM.SearchObjectName}" Width="160" PlaceholderText="e.g. M31" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Object type" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding SkyAtlasVM.ObjectTypes}" SelectedItem="{Binding SkyAtlasVM.SelectedObjectType}" Width="160" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Constellation" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding SkyAtlasVM.Constellations}" SelectedItem="{Binding SkyAtlasVM.SelectedConstellation}" Width="140" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Magnitude from" FontWeight="SemiBold" />
                            <NumericUpDown Value="{Binding SkyAtlasVM.MagnitudeFrom}" Width="110" FormatString="0.##" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Magnitude through" FontWeight="SemiBold" />
                            <NumericUpDown Value="{Binding SkyAtlasVM.MagnitudeThrough}" Width="110" FormatString="0.##" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Button Content="Search" Command="{Binding SkyAtlasVM.SearchCommand}" Margin="0,0,8,0" />
                            <Button Content="Reset" Command="{Binding SkyAtlasVM.ResetFiltersCommand}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Margin="0,0,0,8" Opacity="0.7" Text="{Binding SkyAtlasVM.StatusMessage}" />
                    <StackPanel Grid.Row="2" Margin="0,0,0,8" Orientation="Horizontal">
                        <Button Content="Frame This" Command="{Binding FrameSelectedCommand}"
                                ToolTip.Tip="Send the selected result to Framing Assistant and switch to that tab." />
                    </StackPanel>
                    <ListBox Grid.Row="3" ItemsSource="{Binding SkyAtlasVM.SearchResults}" SelectedItem="{Binding SkyAtlasVM.SelectedResult}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="160,80,90,90,70">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding DSOType}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Coordinates.RAString}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Coordinates.DecString}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Magnitude}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="Framing Assistant">
                <!-- First real slice (2026-07-24): renders the grid/DSO/constellation overlay
                     (SkyMapAnnotator.RenderPortable) and the cached-sky-image background
                     (CacheSkySurveyImageFactory.RenderPortable) for a manually-entered target -
                     both via the ImageSharp-based *Portable path in NINA.WPF.Base's SkySurvey
                     subsystem. Fetch-on-demand and pan/zoom added 2026-08-02 (see
                     FramingAssistantViewModel doc comment) - still not built: a real file-picker
                     path for FileSkySurvey via Avalonia's IStorageProvider. -->
                <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*">
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Target name" FontWeight="SemiBold" />
                            <TextBox Text="{Binding FramingAssistantVM.TargetName}" Width="140" PlaceholderText="e.g. M31" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="RA (degrees)" FontWeight="SemiBold" />
                            <NumericUpDown Value="{Binding FramingAssistantVM.TargetRADegrees}" Width="120" FormatString="0.###" Minimum="0" Maximum="360" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Dec (degrees)" FontWeight="SemiBold" />
                            <NumericUpDown Value="{Binding FramingAssistantVM.TargetDec}" Width="120" FormatString="0.###" Minimum="-90" Maximum="90" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Field of view (arcmin)" FontWeight="SemiBold" />
                            <NumericUpDown Value="{Binding FramingAssistantVM.FieldOfViewArcmin}" Width="120" FormatString="0.#" Minimum="1" Maximum="600" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Source" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding FramingAssistantVM.AvailableSources}" SelectedItem="{Binding FramingAssistantVM.Source}" Width="120" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Button Content="Load Framing" Command="{Binding FramingAssistantVM.LoadFramingCommand}" IsEnabled="{Binding !FramingAssistantVM.IsLoading}" Margin="0,0,8,0" />
                            <Button Content="Load From File..." Click="OnLoadFromFileClick" IsEnabled="{Binding !FramingAssistantVM.IsLoading}"
                                    ToolTip.Tip="Load a local FITS/TIFF/etc image instead of fetching from an online survey - uses the file's own WCS or telescope/camera metadata for framing." />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Margin="0,0,0,8" Opacity="0.7" Text="{Binding FramingAssistantVM.StatusMessage}" />
                    <StackPanel Grid.Row="2" Margin="0,0,0,8" Orientation="Horizontal" IsEnabled="{Binding !FramingAssistantVM.IsLoading}">
                        <Button Content="&#8592;" Command="{Binding FramingAssistantVM.PanCommand}" CommandParameter="Left" ToolTip.Tip="Pan left" />
                        <Button Content="&#8593;" Command="{Binding FramingAssistantVM.PanCommand}" CommandParameter="Up" Margin="4,0,0,0" ToolTip.Tip="Pan up" />
                        <Button Content="&#8595;" Command="{Binding FramingAssistantVM.PanCommand}" CommandParameter="Down" Margin="4,0,0,0" ToolTip.Tip="Pan down" />
                        <Button Content="&#8594;" Command="{Binding FramingAssistantVM.PanCommand}" CommandParameter="Right" Margin="4,0,0,0" ToolTip.Tip="Pan right" />
                        <Button Content="Zoom In" Command="{Binding FramingAssistantVM.ZoomInCommand}" Margin="16,0,0,0" />
                        <Button Content="Zoom Out" Command="{Binding FramingAssistantVM.ZoomOutCommand}" Margin="4,0,0,0" />
                    </StackPanel>
                    <Panel Grid.Row="3">
                        <Image Source="{Binding FramingAssistantVM.BackgroundImage}" Stretch="Uniform" />
                        <Image Source="{Binding FramingAssistantVM.OverlayImage}" Stretch="Uniform" />
                    </Panel>
                </Grid>
            </TabItem>
            <TabItem Header="Flat Wizard">
                <TextBlock Margin="0,12,0,0" Opacity="0.6" Text="Flat Wizard - not yet scoped" />
            </TabItem>
            <TabItem Header="Sequencer">
                <!-- Phase 3: a real NINA.Sequencer.Container.SequenceRootContainer
                     (multi-targeted, portable, unchanged from the WPF app's own domain model),
                     hand-populated with a couple of real Annotation items in a nested
                     SequentialContainer as the starting tree content.
                     Move Up/Down/Remove are bound straight to IDroppable's own real
                     MoveUpCommand/MoveDownCommand/DetachCommand - not new logic, the real app's
                     existing reorder/remove behavior. The Add dropdown is real too now: it lists
                     every SequenceItemCatalog.Entries entry, a real reflection-based discovery
                     of the app's actual [Export(typeof(ISequenceItem))]-tagged types whose
                     constructor dependencies this app's DI container can already satisfy - see
                     SequenceItemCatalog's own doc comment for the full design (not a MEF
                     CompositionContainer, a lighter real bridge to this app's own DI container).
                     Still deferred: per-item-type property editors (dozens of types, each with
                     its own settings) and real drag-and-drop gestures.
                     Two DataTemplates, ISequenceContainer listed first: Avalonia picks the first
                     matching template in TreeView.DataTemplates, and containers are-a
                     ISequenceItem too, so order here is what makes containers get their
                     children shown instead of falling through to the leaf-item template. -->
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding SequencerVM.Catalog.Entries}"
                                  SelectedItem="{Binding SequencerVM.SelectedCatalogEntry}"
                                  Width="260">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Category}" Opacity="0.6" />
                                        <TextBlock Text="-" Opacity="0.6" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Add" Command="{Binding SequencerVM.AddFromCatalogCommand}" />
                        <Button Content="Move Up" Command="{Binding SequencerVM.SelectedItem.MoveUpCommand}" />
                        <Button Content="Move Down" Command="{Binding SequencerVM.SelectedItem.MoveDownCommand}" />
                        <Button Content="Remove" Command="{Binding SequencerVM.SelectedItem.DetachCommand}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,260">
                        <TreeView Name="SequencerTree" Grid.Column="0" ItemsSource="{Binding SequencerVM.RootContainer.Items}" SelectedItem="{Binding SequencerVM.SelectedItem}">
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="seqc:ISequenceContainer" ItemsSource="{Binding Items}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </TreeDataTemplate>
                                <DataTemplate DataType="seq:ISequenceEntity">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                        <!-- Generic reflection-based property panel (PropertyEditRow) for
                             whatever's selected - see SequencerViewModel's doc comment for why
                             this is one uniform editor instead of 52+ hand-built per-item-type
                             views. Only simple value-typed, leaf-declared properties show up
                             here; anything else is deliberately absent rather than shown broken. -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
                            <TextBlock Text="Properties" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding SequencerVM.SelectedItemProperties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,*" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Imaging">
                <!-- Phase 2's first real slice: a real capture through the actual portable
                     pipeline (CameraVM.Capture/Download -> ToImageData -> RenderImage ->
                     Stretch -> RawPixels -> a real Avalonia bitmap), not a placeholder. Connect
                     a camera on the Equipment tab first (the Simulator camera works with no
                     real hardware) - Connected is bound compiled since ICameraVM declares it
                     directly (IDeviceVM&lt;T&gt; base member), unlike the ReflectionBinding
                     paths used for the concrete-only members on the Equipment tab's cards. -->
                <StackPanel Margin="0,12,0,0" Spacing="8" MaxWidth="700">
                    <!-- Exposure/binning/gain sourced from the connected camera's own
                         CameraInfo.BinningModes/Gains (ImagingViewModel.RefreshCameraSettings,
                         run on the Connected event) - not hardcoded, reflects whatever the real
                         device actually reports. -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="Exposure (s)" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding ImagingVM.ExposureTime}" Minimum="0.001" Increment="0.5" Width="110" FormatString="0.###" />
                        <TextBlock Grid.Column="2" Text="Binning" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding ImagingVM.AvailableBinningModes}" SelectedItem="{Binding ImagingVM.SelectedBinning}" Width="90">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="4" Text="Gain" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <NumericUpDown Grid.Column="5" Value="{Binding ImagingVM.Gain}" Minimum="{Binding ImagingVM.GainMin}" Maximum="{Binding ImagingVM.GainMax}" Width="100" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="Capture" Command="{Binding ImagingVM.CaptureCommand}" IsEnabled="{Binding !ImagingVM.IsCapturing}" />
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding ImagingVM.CancelCaptureCommand}" IsEnabled="{Binding ImagingVM.IsCapturing}" />
                        <TextBlock Grid.Column="2" Text="{Binding ImagingVM.CaptureStatus}" VerticalAlignment="Center" />
                    </Grid>
                    <Border BorderBrush="Gray" BorderThickness="1" MinHeight="300">
                        <!-- StarOverlayImage is a second, same-pixel-dimensions ImageSharp-drawn
                             layer (real circles at each DetectedStar.Position) stacked over the
                             base image with the same Stretch="Uniform" - both scale/letterbox
                             identically, so the markers land on the real stars with no manual
                             coordinate math (see ImagingViewModel's doc comment). -->
                        <Panel>
                            <Image Source="{Binding ImagingVM.Image}" Stretch="Uniform" />
                            <Image Source="{Binding ImagingVM.StarOverlayImage}" Stretch="Uniform" />
                        </Panel>
                    </Border>
                    <!-- Real StarDetection.DetectPortable() output (via IRenderedImage.
                         DetectStars(), see ImagingViewModel's doc comment) - text stats plus the
                         real visual marker overlay drawn on the image above. -->
                    <TextBlock Text="{Binding ImagingVM.StarDetectionStatus}" Opacity="0.8" />
                    <!-- Real IImageData.Statistics (mean/median/stdev/min/max), same source
                         NINA/ViewModel/ImageStatisticsVM.cs uses. -->
                    <TextBlock Text="{Binding ImagingVM.StatisticsStatus}" Opacity="0.8" />
                    <!-- Real OxyPlot.Avalonia PlotView bound to the real IImageStatistics.Histogram
                         data - OxyPlot's model/series types are UI-framework-agnostic, only the
                         rendering package differs from the WPF app's OxyPlot.Wpf. -->
                    <oxy:PlotView Model="{Binding ImagingVM.HistogramModel}" Height="180" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Options">
                <!-- Phase 5 first slice: a real settings editor over the active profile's real,
                     unchanged NINA.Profile settings objects, using the same generic
                     reflection-based PropertyEditRow built for the Sequencer's property panel
                     (see OptionsViewModel doc comment) rather than one hand-built view per
                     category (real design work for each of the ~20 real WPF Options sub-views).
                     Profile switcher up top - real IProfileService.SelectProfile(), see
                     OptionsViewModel's doc comment for the known limitation (already-constructed
                     equipment VMs don't get re-initialized against the new profile). -->
                <Grid Margin="12" RowDefinitions="Auto,Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="Profile" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding OptionsVM.Profiles}" SelectedItem="{Binding OptionsVM.SelectedProfile}" Width="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding OptionsVM.ProfileStatusMessage}" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>

                    <!-- Real NINA theme support (2026-08-22) - the real, portable
                         ColorSchemaSettings.ColorSchemas.Items (16 built-in palettes + 2 custom
                         slots), same data the real WPF app's own Theme picker uses. "Use plain
                         default" defaults on (today's existing look, kept per user request in
                         wokka1/nina#1) - real NINA colors are opt-in via this checkbox, not
                         forced on switch. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="Theme" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding OptionsVM.AvailableThemes}" SelectedItem="{Binding OptionsVM.SelectedTheme}" Width="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="Use plain default (this port's own look)" IsChecked="{Binding OptionsVM.UsePlainDefault}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnDefinitions="220,*">
                        <ListBox Grid.Column="0" ItemsSource="{Binding OptionsVM.Categories}" SelectedItem="{Binding OptionsVM.SelectedCategory}" />
                        <ItemsControl Grid.Column="1" Margin="16,0,0,0" ItemsSource="{Binding OptionsVM.SettingsProperties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="200,*" Margin="0,0,0,6">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Plugins">
                <!-- Real IPluginLoader (NINA.Plugin, now portable - see project memory) behind
                     this tab. Load is user-triggered, not automatic at startup - real filesystem
                     scan + MEF composition, not something to run unprompted every dev launch. -->
                <StackPanel Margin="0,12,0,0" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Load Plugins" Command="{Binding PluginsVM.LoadPluginsCommand}" />
                        <TextBlock Text="{Binding PluginsVM.StatusMessage}" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding PluginsVM.Plugins}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="220,160,100,80">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Author}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Version}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Enabled}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>

    <!-- Sequencer drag-and-drop visual polish (2026-08-22): the OS-level DoDragDropAsync call in
         MainWindow.axaml.cs doesn't render any custom drag-clone image (that's entirely up to the
         platform, and native cross-app drag imagery isn't reachable from Avalonia), so this ghost
         is a hand-tracked overlay instead - repositioned to the pointer in code-behind's
         OnSequencerDragOver, shown/hidden around the DoDragDropAsync call. Same idea for the
         drop-zone highlight: a thin bar positioned over whichever TreeViewItem/zone
         DetermineDropZone currently resolves to. Both IsHitTestVisible="False" so they never
         steal the drop target from whatever's underneath. -->
    <Border x:Name="DragGhost" IsVisible="False" IsHitTestVisible="False"
            Background="#CC1E3A5F" BorderBrush="#FF4A90D9" BorderThickness="1" CornerRadius="4"
            Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock x:Name="DragGhostText" Foreground="White" FontSize="12" />
    </Border>

    <Border x:Name="DropZoneHighlight" IsVisible="False" IsHitTestVisible="False"
            Background="#664A90D9" BorderBrush="#FF4A90D9" BorderThickness="0"
            HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Panel>

</Window>
