<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF Condition="'$(TargetFramework)'=='net10.0-windows'">true</UseWPF>
    <DefineConstants Condition="'$(TargetFramework)'=='net10.0-windows'">$(DefineConstants);HAS_WPF</DefineConstants>
    <ImportWindowsDesktopTargets Condition="'$(TargetFramework)'=='net10.0-windows'">true</ImportWindowsDesktopTargets>
    <Configurations>Debug;Release;SignedRelease</Configurations>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'SignedRelease|AnyCPU'">
    <OutputPath>bin\SignedRelease\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
    <Page Remove="publish\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs">
      <Link>Properties\CommonAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\NINA\Resources\ninasplash.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Accord.Imaging\Accord.Imaging (NETStandard).csproj" />
    <ProjectReference Include="..\NINA.Astrometry\NINA.Astrometry.csproj" />
    <ProjectReference Include="..\NINA.Core\NINA.Core.csproj" />
    <ProjectReference Include="..\NINA.Equipment\NINA.Equipment.csproj" />
    <ProjectReference Include="..\NINA.Image\NINA.Image.csproj" />
    <ProjectReference Include="..\NINA.MGEN\NINA.MGEN.csproj" />
    <ProjectReference Include="..\NINA.Platesolving\NINA.PlateSolving.csproj" />
    <ProjectReference Include="..\NINA.Profile\NINA.Profile.csproj" />
    <ProjectReference Include="..\NINA.CustomControlLibrary\NINA.CustomControlLibrary.csproj" Condition="'$(TargetFramework)'=='net10.0-windows'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AsyncEnumerator" Version="4.0.2" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="DotNetProjects.Extended.Wpf.Toolkit" Version="5.0.129" Condition="'$(TargetFramework)'=='net10.0-windows'" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" Condition="'$(TargetFramework)'=='net10.0-windows'" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" Condition="'$(TargetFramework)'=='net10.0-windows'" />
    <PackageReference Include="Nito.Mvvm.Async" Version="1.0.0-pre-04" />
    <PackageReference Include="OxyPlot.Contrib" Version="2.1.2" />
    <PackageReference Include="OxyPlot.Contrib.Wpf" Version="2.1.2" Condition="'$(TargetFramework)'=='net10.0-windows'" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" Condition="'$(TargetFramework)'=='net10.0-windows'" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Utility\Converters\" />
  </ItemGroup>
  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>$(AssemblyName)</Title>
    <Version>3.3.0.1049-nightly</Version>
    <Authors>Stefan Berg and the N.I.N.A. Contributors</Authors>
    <Product>N.I.N.A. - Nighttime Imaging 'N' Astronomy</Product>
    <Description>This assembly contains the basic WPF components of N.I.N.A.</Description>
    <Copyright>Copyright ©  2016 - 2026 Stefan Berg and the N.I.N.A. contributors</Copyright>
    <RepositoryUrl>https://github.com/isbeorn/nina.git</RepositoryUrl>
    <PackageProjectUrl>https://nighttime-imaging.eu/</PackageProjectUrl>
    <PackageIcon>ninasplash.png</PackageIcon>
    <PackageOutputPath>$(SolutionDir)publish</PackageOutputPath>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec IgnoreExitCode="true" Command="  if exist &quot;$(SolutionDir)Accord.Imaging\bin\SignedRelease\netstandard2.0\Accord.Imaging.dll&quot; echo F | xcopy &quot;$(SolutionDir)Accord.Imaging\bin\SignedRelease\netstandard2.0\Accord.Imaging.dll&quot; &quot;$(ProjectDir)bin\SignedRelease\Accord.Imaging\bin\SignedRelease\netstandard2.0\Accord.Imaging.dll&quot; /h/i/c/k/e/r/y   &#xD;&#xA;  if exist &quot;$(SolutionDir)OxyPlot.Contrib.Wpf\bin\SignedRelease\netcoreapp3.1\OxyPlot.Contrib.Wpf.dll&quot; echo F | xcopy &quot;$(SolutionDir)OxyPlot.Contrib.Wpf\bin\SignedRelease\netcoreapp3.1\OxyPlot.Contrib.Wpf.dll&quot; &quot;$(ProjectDir)bin\SignedRelease\OxyPlot.Contrib.Wpf\bin\SignedRelease\netcoreapp3.1\OxyPlot.Contrib.Wpf.dll&quot; /h/i/c/k/e/r/y &#xD;&#xA;&#xD;&#xA;  if $(Configuration) == SignedRelease signtool sign /t http://timestamp.sectigo.com /i Sectigo /v /a /fd SHA256 $(TargetPath)" />
  </Target>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <!-- References NINA.CustomControlLibrary's IAutoCompleteItem, which is not yet portable -
         deep-sky search autocomplete is Phase 4 (SkyAtlas/FramingAssistant) territory, not
         needed for the equipment VMs this multi-target pass is really after. Revisit then. -->
    <Compile Remove="Interfaces\ViewModel\IDeepSkyObjectSearchVM.cs" />

    <!-- WPF attached behaviors (Microsoft.Xaml.Behaviors.Wpf) - pure UI plumbing, no portable logic. -->
    <Compile Remove="Behaviors\BrowserBehavior.cs" />
    <Compile Remove="Behaviors\BubbleScrollEvent.cs" />
    <Compile Remove="Behaviors\DragCommandBehavior.cs" />
    <Compile Remove="Behaviors\MouseCommandBehavior.cs" />
    <Compile Remove="Behaviors\MouseFollowBehavior.cs" />
    <Compile Remove="Behaviors\MouseWheelCommandBehavior.cs" />

    <!-- XAML code-behind - UserControl/Window partial classes, no portable logic. -->
    <Compile Remove="View\AltitudeChart.xaml.cs" />
    <Compile Remove="View\Browser.xaml.cs" />
    <Compile Remove="View\BrowserPopupButton.xaml.cs" />
    <Compile Remove="View\ImageView.xaml.cs" />
    <Compile Remove="View\PopupButton.xaml.cs" />
    <Compile Remove="InputBox\InputBox.xaml.cs" />
    <Compile Remove="Model\Equipment\MySafetyMonitor\Simulator\SafetyMonitorSimulatorSetup.xaml.cs" />
    <Compile Remove="Model\Equipment\MyCamera\Simulator\SetupView.xaml.cs" />

    <!-- FramingAssistant / SkyAtlas image-survey subsystem - same Phase 4 territory as
         IDeepSkyObjectSearchVM.cs above. These are WPF BitmapSource image-compositing
         providers and the sky-map annotation renderer for the framing assistant; there is
         no separable portable logic left once the WPF bitmap pipeline is removed, and
         building a portable replacement rendering pipeline is out of scope for this pass.
         Revisit alongside IDeepSkyObjectSearchVM.cs in Phase 4.

         UPDATE 2026-07-24: a real portable rendering/fetch/cache path (*Portable methods) was
         written for every file below except FileSkySurvey.cs, and the actual ImageSharp APIs they
         use were verified for real at runtime via a disposable console harness (font resolution,
         rotation/compositing math, drawing calls - all against the real ImageSharp/ImageSharp.Drawing
         packages, not mocked) - see NINA.WPF.Base/SkySurvey/Portable/ and commits
         1c1b54dd2/80f0c9010/de8bee521. IMPORTANT CAVEAT found after committing: none of this was
         ever actually compiled *as part of NINA.WPF.Base's own net10.0 build* - these files stayed
         excluded here the whole time, so every "0 errors on net10.0" build during that work was
         real but misleading (nothing to error on, since the files weren't in the build). Still
         excluded here on purpose now, correction pending: each file's *original*
         WPF/BitmapSource-dependent members need
         #if HAS_WPF wrapping first (same pattern used for NINA.Core/NINA.Profile/etc during the
         backend-portability phase) before this whole file can be un-excluded and compile for real
         alongside the *Portable additions - not done yet, sized as its own follow-up rather than
         risk leaving a half-wrapped file committed. SkyMapAnnotator.cs is the biggest piece of that
         follow-up: it implements ISkyMapAnnotator (BitmapSource + System.Windows.Vector in its own
         contract, itself WPF-only, see the exclusion below) and has several WPF-typed fields beyond
         just its Render() method (BitmapSource SkyMapOverlay, System.Drawing Bitmap/Graphics
         buffers) that all need gating too, not just the one method. -->
    <Compile Remove="Interfaces\ViewModel\IFramingAssistantVM.cs" />
    <Compile Remove="Interfaces\ViewModel\ISkyMapAnnotator.cs" />
    <Compile Remove="Model\FramingAssistant\FramingDSO.cs" />
    <Compile Remove="Model\FramingAssistant\FrameLineMatrix2.cs" />
    <Compile Remove="Model\FramingAssistant\FramingConstellation.cs" />
    <Compile Remove="Model\FramingAssistant\FramingConstellationBoundary.cs" />
    <Compile Remove="SkySurvey\CacheSkySurvey.cs" />
    <Compile Remove="SkySurvey\CacheSkySurveyImageFactory.cs" />
    <Compile Remove="SkySurvey\ESOSkySurvey.cs" />
    <Compile Remove="SkySurvey\FileSkySurvey.cs" />
    <Compile Remove="SkySurvey\Hips2FitsSurvey.cs" />
    <Compile Remove="SkySurvey\ISkySurvey.cs" />
    <Compile Remove="SkySurvey\MosaicSkySurvey.cs" />
    <Compile Remove="SkySurvey\NASASkySurvey.cs" />
    <Compile Remove="SkySurvey\SkyAtlasSkySurvey.cs" />
    <Compile Remove="SkySurvey\SkyMapAnnotator.cs" />
    <Compile Remove="SkySurvey\SkyServerSkySurvey.cs" />
    <Compile Remove="SkySurvey\SkySurveyFactory.cs" />
    <Compile Remove="SkySurvey\StsciSkySurvey.cs" />

    <!-- Pure WPF utility classes (DataTemplateSelector, ResourceDictionary subclass, and a
         Dispatcher-bound progress factory / IDispatcher backing) - no separable portable logic,
         not referenced from anywhere outside XAML. -->
    <Compile Remove="Utility\GenericTemplateSelector.cs" />
    <Compile Remove="Utility\ProgressFactory.cs" />
    <Compile Remove="Utility\SharedResourceDictionary.cs" />
    <Compile Remove="Utility\WpfDispatcher.cs" />
  </ItemGroup>
</Project>
